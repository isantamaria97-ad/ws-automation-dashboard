# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real tokens.

# Jira (Atlassian Cloud) — create token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@applydigital.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Testmo — create token at https://applydigital.testmo.net/admin/user/tokens
TESTMO_API_TOKEN=your_testmo_api_token_here

# Testmo project ID (B2B automation = 9)
TESTMO_PROJECT_ID=9

# Testmo automation source (17 = "e2etests") and run-name regex for the scope
TESTMO_AUTOMATION_SOURCE_ID=17
TESTMO_RUN_NAME_PATTERN=^CL.*B2B Web

# Root folder for case-coverage scope (717 = "Flujos  B2B WEB > Chile")
TESTMO_SCOPE_FOLDER_ID=717
